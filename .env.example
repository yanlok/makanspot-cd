# Copy this file to .env and fill in your values. NEVER commit .env.
# Local pipeline scripts (scripts/*.mjs) read these from .env.

# Required for --instagram / --trending / --places scrape modes (Apify)
APIFY_TOKEN=apify_api_...

# LLM provider (caption extraction + hashtag discovery + AI food-check).
# Priority: MIMO_* > LLM_* > OPENAI_*  (OpenAI-compatible endpoints)
MIMO_API_KEY=
MIMO_BASE_URL=https://api.openai.com/v1
MIMO_MODEL=gpt-4o-mini
# LLM_API_KEY=...
# LLM_BASE_URL=...
# LLM_MODEL=...
# OPENAI_API_KEY=...

# Required for geocoding + map-card images (Mapbox free tier: 100K + 50K req/month)
MAPBOX_TOKEN=pk.eyJ...

# Supabase project (anon key is public — the pipeline scripts default to the
# project's publishable key; override if it changes)
# SUPABASE_PROJECT_REF=npmdrgpypkozdjtiplmf
# SUPABASE_ANON_KEY=sb_publishable_...
# FUNCTIONS_BASE_URL=https://<ref>.functions.supabase.co

# Pipeline tunables (optional)
# BATCH_SIZE=50
# ENRICH_LIMIT=15
# MIN_CONFIDENCE=0.5
# RESULTS_LIMIT=20
